# Active LLM provider: groq | openai
# groq uses LLM_CHAT_MODEL; openai uses OPENAI_CHAT_MODEL.
LLM_PROVIDER=groq

# Chat model used for extraction and explanation
LLM_CHAT_MODEL=openai/gpt-oss-20b

# Embedding model. Changing this invalidates the vector index (see docs/journal.md).
LLM_EMBEDDING_MODEL=text-embedding-3-small

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Groq (GPT-OSS 20B for extraction)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Extraction cache. Disable only to force a full re-extraction.
EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_DIR=../data/cache

# Local Postgres + pgvector (docker compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql://career_match:career_match@127.0.0.1:5433/career_match
EMBEDDING_DIMENSIONS=1536
